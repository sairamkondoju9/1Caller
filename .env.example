# ==============================================================================
# SARVAM / OUTPERO VOICE ENGINE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3001
NODE_ENV=production

# Security & Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=
OWNER_EMAILS=
ADMIN_EMAILS=

# Durable account storage (required on Vercel)
# This app currently uses Turso/libSQL for its shared cloud database; DATABASE_URL alone is not wired into server/db.js.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=

# Payments (optional; wallet top-ups remain disabled unless both are configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Language models
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Telecom SIP Trunks (Exotel Primary, Plivo Secondary, Twilio Tertiary)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Speech & Language Models
SARVAM_API_KEY=
CARTESIA_API_KEY=
VLLM_LLM_ENDPOINT=http://localhost:8000/v1

# External voice sessions (Vercel cannot host the persistent WebSocket gateway)
VOICE_WS_URL=

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
