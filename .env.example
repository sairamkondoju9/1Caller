# ==============================================================================
# SARVAM / OUTPERO VOICE ENGINE - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

PORT=3001
NODE_ENV=production

# Security & Authentication
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
GOOGLE_CLIENT_ID=
OWNER_EMAILS=
ADMIN_EMAILS=
# Optional: comma-separated email:password pairs that enable the test-login route. Leave blank in production.
TEST_LOGIN_CREDENTIALS=

# Transactional email (required for email-OTP sign-in on Vercel; without both the route returns 503)
RESEND_API_KEY=
AUTH_EMAIL_FROM=

# Durable account storage (required on Vercel)
# This app currently uses Turso/libSQL for its shared cloud database; DATABASE_URL alone is not wired into server/db.js.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
DATABASE_URL=

# Payments (optional; wallet top-ups remain disabled unless both are configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required for the server-to-server settlement webhook; while unset /api/billing/webhook returns 503
RAZORPAY_WEBHOOK_SECRET=

# Language models
GROQ_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# Telecom SIP Trunks (Exotel Primary, Plivo Secondary, Twilio Tertiary)
EXOTEL_ACCOUNT_SID=
EXOTEL_API_KEY=
EXOTEL_API_TOKEN=
EXOTEL_SUB_DOMAIN=api.exotel.com
PLIVO_AUTH_ID=
PLIVO_AUTH_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Speech & Language Models
SARVAM_API_KEY=
CARTESIA_API_KEY=
VLLM_LLM_ENDPOINT=http://localhost:8000/v1

# Sarvam telephony (outbound/inbound voice calls). Falls back to SARVAM_API_KEY when blank.
SARVAM_TELEPHONY_API_KEY=
SARVAM_PRIMARY_CLI=
SARVAM_ORG_ID=
SARVAM_WORKSPACE_ID=
SARVAM_APP_ID=
SARVAM_CONNECTION_ID=

# External voice sessions (Vercel cannot host the persistent WebSocket gateway; while unset real-time in-browser voice is disabled)
VOICE_WS_URL=

# WhatsApp Cloud API
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Set to true only for local demos; seeds sample tenants/users. Must stay unset in production.
ENABLE_DEMO_DATA=
